# Скопируйте в .env.local и заполните значениями из Supabase → Project Settings → API.
# Пока переменные пустые, приложение работает в локальном демо-режиме (данные в браузере).
# Сюда кладётся только публичный ключ (anon / publishable). Service-role ключ в клиент не кладут.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
